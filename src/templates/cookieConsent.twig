{% set cookieBar = cookieConsent.getSettings() %}

<div class="cookie-opener-icon">
	<button>
		<span class="button-icon">{{ include('_craft-cookies/_svg/cookie-opener') }}</span>
		<span class="sr-only">{{ 'Toggle Cookie Banner'|t }}</span>
	</button>
</div>
<div class="cookie-consent-bar bottom-right">
	<button class="cookie-banner-close" data-action="close-banner">
		{{ include('_craft-cookies/_svg/close') }}
		<span class="sr-only">{{ 'Close Banner'|t }}</span>
	</button>
	<div class="cookie-image">{{ include('_craft-cookies/_svg/cookie') }}</div>
	<div class="cookie-consent-content">
		<div class="cookie-consent-text">
			<h3>{{ generalSettings.bannerTitle|raw }}</h3>
			<div class="cookie-consent-text-inner">
				{{ generalSettings.bannerMessage|raw }}
			</div>
			<div class="cookie-consent-buttons">
				<button class="cookie-consent-button primary" data-action="deny-all">
					<span>{{ generalSettings.denyText|raw|t }}</span>
				</button>
				<button class="cookie-consent-button secondary" data-action="open-settings">
					<span>{{ generalSettings.settingsText|raw }}</span>
				</button>
				<button class="cookie-consent-button primary" data-action="accept-all">
					<span>{{ generalSettings.acceptText|raw }}</span>
				</button>
			</div>
		</div>
		<div class="cookie-consent-footer">
			<p>Powered by <a href="https://contentreactor.com/">ContentReactor</a></p>
		</div>
	</div>
	{{ include('_craft-cookies/_settingsPanel') }}
</div>
