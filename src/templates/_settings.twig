{# @var plugin \developion\craftcookies\Plugin #}
{# @var settings \developion\craftcookies\models\Settings #}

{% import '_includes/forms.twig' as forms %}
{% set title = 'Craft Cookies - Project Settings' %}
{% block content %}


	{{ forms.selectField({
		id: 'cookie-banner-position',
		label: 'Cookie Banner Position' | t('_craft-cookies'),
		instructions: 'Position of the cookie banner on the page' | t('_craft-cookies'),
		options: {
			bottomLeft: 'Bottom Left' | t('_craft-cookies'),
			bottom: 'Bottom Center' | t('_craft-cookies'),
			bottomRight: 'Bottom Right' | t('_craft-cookies'),
		},
		name: 'cookieBannerPosition',
		value: settings.cookieBannerPosition,
	}) }}

	{{ forms.textField({
		id: 'cookie-name-prefix',
		label: 'Cookie Name Prefix' | t('_craft-cookies'),
		instructions: 'Prefix that will be used for all cookies generated by the plugin' | t('_craft-cookies'),
		name: 'cookieNamePrefix',
		value: settings.cookieNamePrefix,
	}) }}

	{{ forms.autosuggestField({
		id: 'cookie-manager-url',
		label: 'Cookie Manager Url' | t('_craft-cookies'),
		instructions: 'URL of the Cookie Manager instance used for this website.' | t('_craft-cookies'),
		name: 'cookieManagerUrl',
		suggestEnvVars: true,
		value: settings.cookieManagerUrl,
	}) }}
	{{ forms.autosuggestField({
		id: 'api-key',
		label: 'Api Key' | t('_craft-cookies'),
		instructions: 'Cookie Manager api key.' | t('_craft-cookies'),
		name: 'apiKey',
		suggestEnvVars: true,
		value: settings.apiKey,
	}) }}
{% endblock %}
