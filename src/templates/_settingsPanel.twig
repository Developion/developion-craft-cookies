{% set categories = cookieConsent.getCookieConsent().getCookieCategories()|json_decode %}
{% set cookies = cookieConsent.getCookieConsent().getCookies()|json_decode %}

<div class="cookie-settings-panel">
	<div class="cookie-settings-content">
		<button class="cookie-settings-close" data-action="close-settings">
			{{ include('_craft-cookies/_svg/close') }}
			<span class="sr-only">{{ 'Close Settings'|t }}</span>
		</button>
		<div class="cookie-settings-header">
			<h3>{{ generalSettings.settingsTitle }}</h3>
		</div>
		<div class="cookie-category-wrapper">
			{% for key, item in cookies %}
				{% set title = item.name %}
				{% if item.name is null %}
					{% set title = 'Uncategorized' %}
				{% endif %}
				<div class="cookie-category">
					<div class="cookie-category-header">
						<div class="cookie-category-title">{{ title }} Cookies</div>
						<label class="cookie-category-toggle {% if item.mandatory %}disabled{% endif %}">
							<span class="sr-only">{{ title }} Cookies</span>
							{% set cookieHandle = item.handle ?? 'uncategorized' %}
							<input name="{{ cookieHandle }}" type="checkbox" data-cookie-category="{{ cookieHandle }}" {% if item.mandatory %}disabled{% endif %} {% if checkCookie(cookieHandle) || item.mandatory %}checked{% endif %}>
							<span class="cookie-category-slider">
								<span class="cookie-icon check-icon">{{ include('_craft-cookies/_svg/checkmark') }}</span>
								<span class="cookie-icon close-icon">{{ include('_craft-cookies/_svg/close') }}</span>
							</span>
						</label>
						<button class="category-dropdown-opener">
							<span>{{ include('_craft-cookies/_svg/caret-down') }}</span>
							<span class="sr-only">{{ 'Open category dropdown' }}</span>
						</button>
					</div>
					<div class="cookie-category-description">{{ item.description|raw }}</div>
					<div class="category-services-list">
						{% if item.vendors %}
							{% for vendor in item.vendors %}
								{{ vendor|raw }}
							{% endfor %}
						{% endif %}

					</div>
				</div>
			{% endfor %}
		</div>
		<div class="cookie-settings-footer">
			<button class="cookie-consent-button primary" data-action="save-preferences">{{ generalSettings.saveText }}</button>
		</div>
	</div>
	<div class="cookie-consent-footer">
		<p>Powered by <a href="https://contentreactor.com/">ContentReactor</a></p>
	</div>
</div>
