{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}
{% set fullPageForm = true %}
{% set title = 'Craft Cookies - General Settings' %}
{% if craft.app.getIsMultiSite() %}

	{% if craft.app.getVersion()|integer is same as 5 %}
		{% set crumbs = [{
			id: 'site-crumb',
			icon: 'world',
			label: requestedSite.name|t('site'),
			menu: {
				items: callIfExists('siteMenuItems', null, requestedSite)|default({}),
				label: 'Select site'|t('app')
			},
		}] %}
	{% else %}
		{% set contextMenu %}
			{% include '_elements/sitemenu' with {
				urlFormat: (craft.app.request.getPathInfo() ~ (craft.app.request.getQueryString() ? ('?' ~ craft.app.request.getQueryString() ~ '&site={handle}') : '?site={handle}'))
			} %}
		{% endset %}
	{% endif %}
{% endif %}

{% block content %}
	{{ actionInput('_craft-cookies/settings/save') }}
	{{ hiddenInput('siteId', craft.app.getSites().getSiteByHandle(siteHandle).id) }}

	{{ forms.textField({
		id: 'banner-title',
		label: 'Banner Title' | t('_craft-cookies'),
		instructions: 'Title of the initial banner.' | t('_craft-cookies'),
		name: 'bannerTitle',
		required: true,
		value: generalSettings.bannerTitle ?? '',
	}) }}

	{{ forms.field({
		id: 'banner-title',
		label: 'Banner Message' | t('_craft-cookies'),
		instructions: 'Message of the initial banner.' | t('_craft-cookies'),
		name: 'bannerMessage',
		required: true,
	}, bannerMessage|raw) }}

	{{ forms.textField({
		id: 'deny-text',
		label: 'Deny Button Text' | t('_craft-cookies'),
		instructions: 'Deny button text.' | t('_craft-cookies'),
		name: 'denyText',
		required: true,
		value: generalSettings.denyText ?? '',
	}) }}

	{{ forms.textField({
		id: 'accept-text',
		label: 'Accept All button text' | t('_craft-cookies'),
		instructions: 'Accept All button text.' | t('_craft-cookies'),
		name: 'acceptText',
		required: true,
		value: generalSettings.acceptText ?? '',
	}) }}

	{{ forms.textField({
		id: 'settings-text',
		label: 'Cookie Settings button text' | t('_craft-cookies'),
		instructions: 'Cookie Settings button text.' | t('_craft-cookies'),
		name: 'settingsText',
		required: true,
		value: generalSettings.settingsText ?? '',
	}) }}

	{{ forms.textField({
		id: 'save-text',
		label: 'Save Preferences button text' | t('_craft-cookies'),
		instructions: 'Save Preferences button text.' | t('_craft-cookies'),
		name: 'saveText',
		required: true,
		value: generalSettings.saveText ?? '',
	}) }}

	{{ forms.textField({
		id: 'settings-title',
		label: 'Settings Title' | t('_craft-cookies'),
		instructions: 'Title of the banner that appears when Cookie Settings is clicked.' | t('_craft-cookies'),
		name: 'settingsTitle',
		value: generalSettings.settingsTitle ?? '',
	}) }}
{% endblock %}
