{% for cookie in data %}
	<div class="cookie">
		{% if cookie.cookie_name is defined %}
			<div><strong>Cookie Name:</strong>{{ cookie.cookie_name }}</div>
		{% endif %}

		{% if cookie.vendor is defined %}
			<div><strong>Vendor:</strong>{{ cookie.vendor }}</div>
		{% endif %}

		{% if cookie.category is defined %}
			<div><strong>Category:</strong>{{ cookie.category }}</div>
		{% endif %}

		{% if cookie.description is defined %}
			<div><strong>Description:</strong>{{ cookie.description }}</div>
		{% endif %}
	</div>
{% endfor %}
