<table class="cookie-descriptions-table">
	<colgroup><col style="width: 20%"/><col style="width: 20%"/><col style="width: 40%"/><col style="width: 10%"/></colgroup>
	<thead>
		<tr>
			<th>{{ 'Name' | t('_craft-cookies' ) }}</th>
			<th>{{ 'Vendor' | t('_craft-cookies' ) }}</th>
			<th>{{ 'Description' | t('_craft-cookies' ) }}</th>
			<th>{{ 'Category' | t('_craft-cookies' ) }}</th>
		</tr>
	</thead>
	<tbody>
		{% for cookie in data %}
			<tr>
				<td>{{ cookie.cookie_name }}</td>
				<td>{{ cookie.vendor ?? '' }}</td>
				<td>{{ cookie.description ?? '' }}</td>
				<td>{{ cookie.category ?? '' }}</td>
			</tr>
		{% endfor %}
	</tbody>
</table>
