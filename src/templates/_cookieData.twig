<table class="cookie-descriptions-table">
	<colgroup><col style="width: 20%"/><col style="width: 20%"/><col style="width: 40%"/><col style="width: 10%"/></colgroup>
	<thead>
		<tr>
			<th>{{ 'Name' | t('_craft-cookies' ) }}</th>
			<th>{{ 'Vendor' | t('_craft-cookies' ) }}</th>
			<th>{{ 'Description' | t('_craft-cookies' ) }}</th>
			<th>{{ 'Category' | t('_craft-cookies' ) }}</th>
		</tr>
	</thead>
	<tbody>
		{% for cookie in data %}
			<tr>
				<td data-cell="{{ cookie.cookie_name }}">{{ cookie.cookie_name }}</td>
				<td data-cell="{{ cookie.vendor ?? '' }}">{{ cookie.vendor ?? '' }}</td>
				<td data-cell="{{ cookie.description ?? '' }}">{{ cookie.description ?? '' }}</td>
				<td data-cell="{{ cookie.category ?? '' }}">{{ cookie.category ?? '' }}</td>
			</tr>
		{% endfor %}
	</tbody>
</table>

{% css %}
	.cookie-descriptions-table {
		--dark-color: var(--watercourse);
		--light-color: #fff;
	}
{% endcss %}
