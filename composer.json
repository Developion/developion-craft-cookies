{
	"name": "developion/craft-cookies",
	"description": "Cookie Manager",
	"type": "craft-plugin",
	"version": "1.0.5",
	"require": {
		"php": ">=8.1",
		"craftcms/cms": "^4.14.0||^5.0"
	},
	"autoload": {
		"psr-4": {
			"developion\\craftcookies\\": "src/"
		}
	},
	"extra": {
		"handle": "_craft-cookies",
		"name": "Craft Cookies",
		"developer": "Developion",
		"documentationUrl": ""
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.0.2"
		},
		"allow-plugins": {
			"yiisoft/yii2-composer": true,
			"craftcms/plugin-installer": true
		}
	}
}
